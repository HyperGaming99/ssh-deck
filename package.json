{
  "name": "ssh-deck",
  "desktopName": "ssh-deck.desktop",
  "updates": {
    "repo": "HyperGaming99/ssh-deck"
  },
  "version": "0.1.3",
  "description": "Minimaler SSH-Client im Stil von Termius",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "test": "node test.js",
    "build": "vite build",
    "server": "node server/server.js",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socks": "^2.8.10",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "author": {
    "name": "HyperGaming99",
    "email": "130169800+HyperGaming99@users.noreply.github.com"
  },
  "homepage": "https://github.com/HyperGaming99/ssh-deck",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.hypergaming.sshdeck",
    "productName": "SSH Deck",
    "copyright": "HyperGaming99",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "npmRebuild": false,
    "asar": true,
    "files": [
      "*.js",
      "!test.js",
      "!start.js",
      "!vite.config.js",
      "dist/**/*",
      "assets/icon-512.png",
      "package.json"
    ],
    "artifactName": "ssh-deck-${version}-${env.SHORT_SHA}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "icon.png",
      "maintainer": "HyperGaming99 <130169800+HyperGaming99@users.noreply.github.com>",
      "synopsis": "SSH client with SFTP, keychain and themes"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "icon.png",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
